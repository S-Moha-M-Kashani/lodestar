# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test artifacts
tests/artifacts/
# Node / SQLite
node_modules/
*.db
*.db-journal
*.db-wal
# Real data never leaves this machine: board.db, assistant.db, and Chroma's
# chroma-data/, whose files are not *.db and would otherwise be committed.
databases/real/
# The :3001 sandbox's two boards ship with the repo, so a checkout gets a working
# test board instead of an empty one. They need an explicit exception because the
# *.db rule above would otherwise swallow them.
!databases/test/board-3001.db
!databases/test/assistant-3001.db
# Its Chroma store does not ship: 94 MB across 786 files, and every byte of it is
# derived — `npm run chroma-test` plus a re-index rebuilds it from the boards
# above. Not *.db, so nothing else here would have stopped it.
databases/test/chroma-data-3001/

.idea

# macOS Finder metadata
.DS_Store

backups/

.env
# Subagent-driven-development scratch: ledgers, briefs, review packages.
.superpowers/

.claude/

# Dev-only working material is untracked as of 2026-08-13 (owner decision): it
# lives on this machine's disk only. History up to the untracking stays in past
# commits and the archive/* tags — see docs/archive.md.
#
# The dev-only subtrees only, never docs/ wholesale. docs/README.md and
# docs/superpowers/specs/ are the published design record: they are tracked on
# master and cited by path from both CLAUDE.md files, so ignoring them would
# make the next publication ship links to specs that exist on no branch and no
# remote — only on this machine's disk.
docs/report/
docs/superpowers/plans/
README-Development.md
ROADMAP-Development.md
125.md
docs/
.ruff_cache/
.pytest_cache/

