# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test artifacts
tests/artifacts/
# RAG Lab output: one JSON file per eval run, which is the lab's *only* durable
# artifact — the index, the retrieved contexts and the answers live in process
# memory and are discarded with it. Reproducible from the fixtures,
# machine-specific, and appended to on every sweep.
brain/tests/raglab/.runs/
# `.screens/` is deliberately NOT ignored. A judge screen is the evidence for
# which model was allowed to grade the four deciding metrics, so it is part of
# the argument rather than an artifact of a machine — and the one thing this
# project has already lost to a wiped scratch directory.

# Node / SQLite
node_modules/
*.db
*.db-journal
*.db-wal
# Real data never leaves this machine: board.db, assistant.db, and Chroma's
# chroma-data/, whose files are not *.db and would otherwise be committed.
databases/real/
# The :3001 sandbox ships with the repo, so a checkout gets a working test board
# instead of an empty one. These two need an explicit exception: the *.db rule
# above would otherwise swallow them, while the Chroma store beside them is not
# *.db and needs no help getting in.
!databases/test/board-3001.db
!databases/test/assistant-3001.db

.idea

# macOS Finder metadata
.DS_Store

backups/

.env
# Subagent-driven-development scratch: ledgers, briefs, review packages.
.superpowers/

.vscode/
