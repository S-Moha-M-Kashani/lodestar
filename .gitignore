# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test artifacts
tests/artifacts/
# RAG Lab output: one JSON file per eval run, which is the lab's *only* durable
# artifact — the index, the retrieved contexts and the answers live in process
# memory and are discarded with it. Reproducible from the fixtures,
# machine-specific, and appended to on every sweep.
brain/tests/raglab/.runs/
# `.screens/` is deliberately NOT ignored. A judge screen is the evidence for
# which model was allowed to grade the four deciding metrics, so it is part of
# the argument rather than an artifact of a machine — and the one thing this
# project has already lost to a wiped scratch directory.

# Node / SQLite
node_modules/
*.db
*.db-journal
*.db-wal
# Real data never leaves this machine: board.db, assistant.db, and Chroma's
# chroma-data/, whose files are not *.db and would otherwise be committed.
databases/real/
# The :3001 sandbox's two boards ship with the repo, so a checkout gets a working
# test board instead of an empty one. They need an explicit exception because the
# *.db rule above would otherwise swallow them.
!databases/test/board-3001.db
!databases/test/assistant-3001.db
# Its Chroma store does not ship: 94 MB across 786 files, and every byte of it is
# derived — `npm run chroma-test` plus a re-index rebuilds it from the boards
# above. Not *.db, so nothing else here would have stopped it.
databases/test/chroma-data-3001/

.idea

# macOS Finder metadata
.DS_Store

backups/

.env
# Subagent-driven-development scratch: ledgers, briefs, review packages.
.superpowers/

.vscode/
.claude/

# Dev-only docs, kept local and out of git entirely so no merge can ever
# carry them to master. No git history — back them up outside the repo.
README-Development.md
ROADMAP-Development.md
125.md
