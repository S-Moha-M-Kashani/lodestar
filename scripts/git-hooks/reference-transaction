#!/bin/sh
# Refuse to delete refs/heads/development.
#
# development is where the work is done, one commit at a time. master keeps
# only the release points — each one a merge that summarises a run of
# development commits — so deleting development throws away every step
# between them, which no other branch can give back.
#
# Git runs this hook for every ref transaction, with $1 in
# prepared|committed|aborted and one "<old> <new> <ref>" line per ref on
# stdin. Only "prepared" can still refuse — exiting non-zero there aborts
# the whole transaction, so the branch is never unlinked. Anything else
# must exit 0 or ordinary commits and fetches start failing.
#
# Install: git config core.hooksPath scripts/git-hooks
# (also copied to .git/hooks/reference-transaction, which survives a
# checkout of master, where this file does not exist)

[ "$1" = prepared ] || exit 0

packed="${GIT_DIR:-.git}/packed-refs"

while read -r old new ref; do
	# A deletion sets the new oid to all zeros. Matching on "any character
	# that is not 0" rather than a literal 40 zeros keeps this correct
	# under sha256 repositories, where the oid is 64 characters long.
	case "$new" in
	*[!0]*) continue ;;
	esac
	# `git pack-refs` moves a loose ref into packed-refs and then removes the
	# loose copy, which arrives here as a deletion — indistinguishable, from
	# stdin alone, from `git branch -D`. It writes packed-refs first, so a
	# ref already recorded there at the same oid is being packed, not
	# deleted, and the branch survives the transaction either way. Without
	# this every gc and every repack aborts on a branch nobody touched.
	if [ -f "$packed" ] && grep -qx "$old $ref" "$packed"; then
		continue
	fi
	if [ "$ref" = refs/heads/development ]; then
		echo "refused: development cannot be deleted." >&2
		echo "master keeps only the release points; development is every step" >&2
		echo "between them, and nothing else can give those back." >&2
		echo "To override, remove the reference-transaction hook first." >&2
		exit 1
	fi
done

exit 0
