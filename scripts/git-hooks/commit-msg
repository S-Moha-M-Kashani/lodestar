#!/bin/sh
# Hold every commit message to the rules this repository writes by.
#
# Three of them, and each one was a real problem before it was a check:
#
#   1. No tool or model is ever credited. The log is the project's record, not
#      a transcript of how it was produced. 409 commits carried a
#      Co-Authored-By trailer naming a model before they were rewritten out.
#   2. The subject is a Conventional Commits line of 72 characters or less, so
#      `git log --oneline` stays readable and the type says what kind of change
#      this is without opening it.
#   3. The body is short — a beginner should be able to read it in one breath.
#      A body over 12 lines is a design note, and belongs in docs/ or in the
#      code as a comment, not in the log.
#
# Bypassable with --no-verify, as every hook is. This stops the accident.
#
# Install: npm run hooks

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Strip comments and trailing blanks the editor leaves behind.
body_only=$(grep -v '^#' "$msg_file")
subject=$(printf '%s\n' "$body_only" | sed '/^[[:space:]]*$/d' | head -1)

# An amend-in-progress marker or an empty message: git handles those itself.
[ -n "$subject" ] || exit 0
case "$subject" in
fixup!* | squash!* | amend!*) exit 0 ;;
esac

fail() {
	echo "refused: $1" >&2
	echo "" >&2
	echo "  subject: $subject" >&2
	echo "" >&2
	echo "The rules: Conventional Commits, 72 characters or fewer, no tool or" >&2
	echo "model credited anywhere, and a body of one to four plain sentences." >&2
	echo "Bypass with --no-verify if you really mean it." >&2
	exit 1
}

# 1. authorship traces
if printf '%s\n' "$body_only" | grep -qiE 'co-authored-by:[^<]*(claude|gpt|codex|copilot|anthropic|openai|gemini|llama|assistant|\bbot\b)'; then
	fail "a commit may not credit a tool or a model as an author"
fi
if printf '%s\n' "$body_only" | grep -qiE 'generated with|written by (claude|an ai|chatgpt)|🤖'; then
	fail "a commit may not say it was generated by a tool"
fi

# 2. subject shape
len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt 72 ]; then
	fail "the subject is $len characters; 72 is the limit"
fi
case "$subject" in
Merge\ * | Revert\ * | "Initial commit") ;;
*)
	printf '%s\n' "$subject" |
		grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9/._-]+\))?!?: .' ||
		fail "the subject is not a Conventional Commits line (feat|fix|docs|...: ...)"
	;;
esac

# 3. body length
lines=$(printf '%s\n' "$body_only" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')
if [ "$lines" -gt 13 ]; then
	fail "the message is $lines lines; keep it to a subject and one to four sentences"
fi

exit 0
