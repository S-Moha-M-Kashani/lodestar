#!/bin/sh
# Refuse to push development to any remote.
#
# development is the full copy of this project and deliberately local. It
# carries README-Development.md, ROADMAP-Development.md, 125.md and
# docs/report/ — working notes and a course report that are meant to stay on
# this machine. What gets published is master, which drops all of them.
#
# Git runs this hook as `pre-push <remote-name> <remote-url>` with one
# "<local-ref> <local-sha> <remote-ref> <remote-sha>" line per ref on stdin.
# Exiting non-zero cancels the push before anything leaves the machine.
#
# The check is on the *local* ref, so `git push origin development:main` — the
# same content under another name — is refused too.
#
# Bypassable with --no-verify, as every pre-push hook is. This stops the
# accident, which is the thing that actually happens.
#
# Install: cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x it

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_ref" in
	refs/heads/development)
		;;
	# `git push <remote> HEAD` names no branch, so resolve HEAD ourselves
	# rather than let the one shorthand through.
	HEAD)
		[ "$current" = development ] || continue
		;;
	*)
		continue
		;;
	esac
	echo "refused: development is a local branch and is never pushed." >&2
	echo "It is the full copy — the dev-only docs and the course report live" >&2
	echo "there. Publish from master instead." >&2
	echo "(refused push of $local_ref to $1)" >&2
	exit 1
done

exit 0
