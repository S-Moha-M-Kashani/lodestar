# Lodestar — environment template. `cp .env.example .env` and edit.
#
# Every variable below is commented out at the value the code already uses, so
# an untouched copy is the documented default. Three things this file cannot
# tell you by its own contents:
#
#   1. Docker Compose reads .env; uvicorn does not. Running the brain natively,
#      export it first: `set -a; . ./.env; set +a`.
#   2. An empty value means "that backend's own default", not "unset".
#   3. Every backend seam rejects an unknown value at boot instead of falling
#      back to one you did not choose.
#
# Backend costs and capabilities: README.md.


# ── Keys ─────────────────────────────────────────────────────────────────────
# Held only by the brain — the browser reaches it through the Node proxy and
# never sees a credential.

# Required when BRAIN_LLM=openrouter, when the Assistant's picker selects a
# hosted model, and for the live evals.
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Required when BRAIN_URL_SAFETY=google-safe-browsing, which refuses to boot
# without it.
#GOOGLE_SAFE_BROWSING_KEY=

# Required when BRAIN_TRACING=langsmith, which refuses to boot without it.
#LANGSMITH_API_KEY=


# ── Chat model ───────────────────────────────────────────────────────────────
# ollama = local, free, no key · openrouter = hosted, needs the key above ·
# claude-cli / codex-cli = this machine's CLI subscriptions, no key at all ·
# fake = canned replies for tests.
#BRAIN_LLM=ollama
# Empty resolves through PROVIDER_MODELS (config.py): ollama -> 4skl/gemma4-e2b-mtp,
# openrouter -> openai/gpt-5-nano, claude-cli -> sonnet. Set one only to override.
#BRAIN_MODEL=
#BRAIN_OLLAMA_BASE_URL=http://localhost:11434/v1
#BRAIN_MAX_STEPS=8

# The CLI backends shell out to an already-authenticated binary, so there is no
# key and no base URL. Each binary's path is overridable, which is what lets the
# tests run that seam against a stub script offline. Both are hardened at every
# invocation (llm_cli.py): every built-in tool off, no MCP, no user settings, a
# read-only sandbox, and an empty scratch directory to run in — these are coding
# agents, not completion endpoints.
#
# There is no BRAIN_CLAUDE_CLI_MODEL: BRAIN_MODEL above is the one model knob,
# and it applies to whichever backend BRAIN_LLM names. Two ways to set one
# model is two things to disagree. The Assistant's picker overrides it per
# request either way, per board.
#BRAIN_CLAUDE_CLI_BIN=claude
#BRAIN_CODEX_CLI_BIN=codex


# ── Embeddings ───────────────────────────────────────────────────────────────
# sentence-transformers -> heydariAI/persian-embeddings, Persian-tuned for this
# board's Farsi corpus and the measured choice; needs the `local-embeddings`
# extra and ~2.2 GB, fetched on first retrieval rather than at boot.
# fastembed = smaller ONNX list · fake = offline tests.
#BRAIN_EMBEDDER=sentence-transformers
#BRAIN_EMBED_MODEL=


# ── Reranker ─────────────────────────────────────────────────────────────────
# How the fused candidates are re-ordered before the gate and the answerer see
# them. lexical = IDF term coverage, free, deterministic, offline, and the one
# the shipped precision numbers were measured with · openrouter = a Cohere
# cross-encoder over the /rerank endpoint, which needs the key above and refuses
# to boot without it · fake = offline tests.
#
# The cheap one is the default on purpose, unlike the embedder: that choice was
# measured and this one has not been. openrouter bills a search on every
# question — including the Assistant's recall box — and sends card text to a
# third party. The run that would move this default is written out step by step
# in brain/src/lodestar_brain/retrieval/rerank.py.
#BRAIN_RERANKER=lexical
# For the openrouter backend only. Empty = cohere/rerank-4-fast (lowest latency);
# cohere/rerank-4-pro is the more accurate sibling.
#BRAIN_RERANK_MODEL=

# ── Retrieval gate ───────────────────────────────────────────────────────────
# The relevance gate between retrieval and generation. llm follows the chat
# model · lexical needs none · none disables it.
#BRAIN_GRADER=llm
#BRAIN_GRADE_THRESHOLD=0.4


# ── Chat memory (Chroma) ─────────────────────────────────────────────────────
# The project's container: `npm run chroma` (:8003), sandbox twin
# `npm run chroma-test` (:8004). memory = in-process, no container, no disk.
#BRAIN_CHROMA_URL=http://localhost:8003
# Both derive from BOARD_API_URL when empty, which keeps the :3000 board and the
# :3001 sandbox out of each other's collections.
#BRAIN_CHROMA_DATABASE=
#BRAIN_CHAT_COLLECTION=


# ── The agent's working memory ───────────────────────────────────────────────
# LangGraph's checkpointer (one thread per chat, so reopening a conversation
# resumes it) and its long-term store share this one sqlite file. It is derived
# working memory and no backup covers it: losing it costs the agent its resume,
# never a card and never a recorded turn. Never board.db or assistant.db — those
# are the record, and only the Node server writes them.
#BRAIN_CHECKPOINT_DB=databases/real/brain-checkpoints.db


# ── What a long conversation costs ───────────────────────────────────────────
# Two defences, cheapest first. Past BRAIN_CLEAR_TOOLS_TOKENS the older tool
# results are replaced by a placeholder, keeping the newest
# BRAIN_CLEAR_TOOLS_KEEP of them — no model call, and it drops only what the
# model has already read. Past BRAIN_SUMMARY_TOKENS the older turns are
# collapsed into one summary by the same model that answers, keeping the newest
# BRAIN_SUMMARY_KEEP messages verbatim — that one costs a call and is lossy,
# which is why its trigger is the higher of the two. Either trigger at 0 turns
# its half off. The numbers are conservative rather than measured; the argument
# for them is in brain/src/lodestar_brain/middleware/summarize.py.
#BRAIN_SUMMARY_TOKENS=8000
#BRAIN_SUMMARY_KEEP=20
#BRAIN_CLEAR_TOOLS_TOKENS=4000
#BRAIN_CLEAR_TOOLS_KEEP=3


# ── Voice input ──────────────────────────────────────────────────────────────
# parakeet = local, free, Apple Silicon only, 2.5 GB on first use · openrouter =
# hosted, which Compose pins because the image cannot install mlx · fake =
# offline tests.
#BRAIN_TRANSCRIBER=parakeet
#BRAIN_PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# For the openrouter backend only. Must be a model that genuinely receives
# audio, not one that merely advertises it.
#BRAIN_OMNI_MODEL=google/gemini-2.5-flash-lite


# ── Web-result safety ────────────────────────────────────────────────────────
# Where a search result leads, checked before the model may cite it.
# google-safe-browsing needs the key above · off skips the check · fake is
# scripted for tests.
#BRAIN_URL_SAFETY=google-safe-browsing


# ── Tracing ──────────────────────────────────────────────────────────────────
# Where a turn's trace goes — the graph, its tool calls, its token counts.
# langsmith needs the key above and refuses to boot without it · off means off.
# Off is a switch and not an absence: it is applied in code, because a shell
# still exporting the legacy LANGCHAIN_TRACING_V2 silently outranks the modern
# variable, and because dropping the key makes langsmith warn and send anyway.
#BRAIN_TRACING=off
# Three more variables belong to langsmith itself and nothing in this repo reads
# them, so they get no entry of their own here: LANGSMITH_PROJECT names the
# project traces land in (langsmith's own default is "default"), while
# LANGSMITH_HIDE_INPUTS and LANGSMITH_HIDE_OUTPUTS, set truthy, redact the
# payloads and keep graph shape, latency and per-call token counts — which is
# what a private board wants a trace to show.


# ── Node server ──────────────────────────────────────────────────────────────
# Boards pair with brains by last digit: :3000 <-> :9000, :3001 <-> :9001.
#PORT=3000
#AGENT_URL=http://127.0.0.1:9000
# Which board the brain writes to, from the brain's side.
#BOARD_API_URL=http://127.0.0.1:3000
# An explicit path wins verbatim and suppresses the one-time migration from an
# older home.
#BOARD_DB=databases/real/board.db
#ASSISTANT_DB=databases/real/assistant.db

# Set this in any context that must never touch real data — a scratch script,
# a screenshot run, anything an agent writes to look at the app. With it set,
# resolving the board or the chat record without an explicit BOARD_DB /
# ASSISTANT_DB raises instead of silently opening databases/real/.
#LODESTAR_REFUSE_REAL_DB=1

# One token bucket over /api/agent/* and /api/rag/*. The board API is never
# metered: being over the assistant's limit must not make your cards
# unreachable.
#LODESTAR_AGENT_BURST=60
#LODESTAR_AGENT_PER_MIN=240

# Backups: every test entry point snapshots the board first, and so does a save
# carrying never-seen cards. Test harnesses set LODESTAR_BACKUP_ON_WRITE=0 so
# test boards cannot evict real snapshots. Drive upload is opt-in through
# rclone; a missing rclone warns rather than blocks.
#LODESTAR_BACKUP_ON_WRITE=1
#LODESTAR_BACKUP_DIR=backups
# How many snapshots of each database to keep, and how long to keep them
# regardless of count. A file must be surplus by BOTH to be deleted. Count
# alone was the rule until a measurement found 100 snapshots spanning ten
# days: an agent session writes 20-30 a day, so the count was honoured and
# the point — recovering a mistake noticed a week later — was lost.
#LODESTAR_BACKUP_KEEP=100
#LODESTAR_BACKUP_KEEP_DAYS=90
#LODESTAR_RCLONE_BIN=rclone
# The remote name only — the script appends the destination path.
#LODESTAR_RCLONE_REMOTE=gdrive


# ── Evals ────────────────────────────────────────────────────────────────────
# Live evals call the real model and skip themselves without this. The model
# can be a CLI subscription (BRAIN_LLM=claude-cli/codex-cli, no key at all) or
# OpenRouter with a key — brain/tests/evals/conftest.py is the one gate.
#BRAIN_EVAL_LIVE=0


# ── Fully offline (tests, CI) ────────────────────────────────────────────────
# BRAIN_LLM=fake BRAIN_EMBEDDER=fake BRAIN_CHROMA_URL=memory BRAIN_URL_SAFETY=fake
